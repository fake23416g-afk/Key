local function rrot(x, n)
    return bor(rshift(x, n), lshift(x, 32 - n))
end

local function sha256Hex(message)
    local length = #message
    local bitLength = length * 8
    message = message .. "\128"
    local pad = (56 - (length + 1) % 64) % 64
    message = message .. string.rep("\0", pad)
    local high = math.floor(bitLength / 4294967296)
    local low = bitLength % 4294967296
    message = message .. string.char(
        math.floor(high / 16777216) % 256, math.floor(high / 65536) % 256,
        math.floor(high / 256) % 256, high % 256,
        math.floor(low / 16777216) % 256, math.floor(low / 65536) % 256,
        math.floor(low / 256) % 256, low % 256
    )

    local h0, h1, h2, h3 = 0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a
    local h4, h5, h6, h7 = 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19
    local w = {}

    for chunk = 1, #message, 64 do
        for index = 0, 15 do
            local offset = chunk + index * 4
            w[index] = band(
                lshift(string.byte(message, offset), 24)
                    + lshift(string.byte(message, offset + 1), 16)
                    + lshift(string.byte(message, offset + 2), 8)
                    + string.byte(message, offset + 3),
                0xFFFFFFFF
            )
        end
        for index = 16, 63 do
            local x = w[index - 15]
            local y = w[index - 2]
            local s0 = bxor(rrot(x, 7), rrot(x, 18), rshift(x, 3))
            local s1 = bxor(rrot(y, 17), rrot(y, 19), rshift(y, 10))
            w[index] = band(w[index - 16] + s0 + w[index - 7] + s1, 0xFFFFFFFF)
        end

        local a, b, c, d = h0, h1, h2, h3
        local e, f, g, h = h4, h5, h6, h7

        for index = 0, 63 do
            local s1 = bxor(rrot(e, 6), rrot(e, 11), rrot(e, 25))
            local ch = bxor(band(e, f), band(bnot(e), g))
            local temp1 = band(h + s1 + ch + SHA256_K[index + 1] + w[index], 0xFFFFFFFF)
            local s0 = bxor(rrot(a, 2), rrot(a, 13), rrot(a, 22))
            local maj = bxor(band(a, b), band(a, c), band(b, c))
            local temp2 = band(s0 + maj, 0xFFFFFFFF)

            h = g
            g = f
            f = e
            e = band(d + temp1, 0xFFFFFFFF)
            d = c
            c = b
            b = a
            a = band(temp1 + temp2, 0xFFFFFFFF)
        end

        h0 = band(h0 + a, 0xFFFFFFFF)
        h1 = band(h1 + b, 0xFFFFFFFF)
        h2 = band(h2 + c, 0xFFFFFFFF)
        h3 = band(h3 + d, 0xFFFFFFFF)
        h4 = band(h4 + e, 0xFFFFFFFF)
        h5 = band(h5 + f, 0xFFFFFFFF)
        h6 = band(h6 + g, 0xFFFFFFFF)
        h7 = band(h7 + h, 0xFFFFFFFF)
    end

    return string.format("%08x%08x%08x%08x%08x%08x%08x%08x", h0, h1, h2, h3, h4, h5, h6, h7)
end

local function hmacHex(key, message)
    if #key > 64 then
        local digest = sha256Hex(key)
        local binary = {}
        for byte in digest:gmatch("%x%x") do
            binary[#binary + 1] = string.char(tonumber(byte, 16))
        end
        key = table.concat(binary)
    end
    key = key .. string.rep("\0", 64 - #key)

    local inner, outer = {}, {}
    for index = 1, 64 do
        local byte = string.byte(key, index)
        inner[index] = string.char(bxor(byte, 0x36))
        outer[index] = string.char(bxor(byte, 0x5C))
    end

    local innerHash = sha256Hex(table.concat(inner) .. message)
    local innerBin = {}
    for byte in innerHash:gmatch("%x%x") do
        innerBin[#innerBin + 1] = string.char(tonumber(byte, 16))
    end
    return sha256Hex(table.concat(outer) .. table.concat(innerBin))
end

-- key format: INV1-<expires unix or 0>-<hwid sha256 prefix or ANY>-<nonce>-<signature>
local function validateKey(rawKey, hwid, now)
    if type(rawKey) ~= "string" or rawKey == "" then
        return false, "Ключ не введён"
    end

    local key = rawKey:gsub("%s+", ""):upper()
    local expiresText, hwidPart, nonce, signature = key:match("^INV1%-(%d+)%-([%u%d]+)%-(%x+)%-(%x+)$")
    if not expiresText or #nonce ~= 8 or #signature ~= 16 then
        return false, "Неверный формат ключа"
    end

    local payload = "INV1-" .. expiresText .. "-" .. hwidPart .. "-" .. nonce
    if hmacHex(SECRET, payload):sub(1, 16):upper() ~= signature then
        return false, "Ключ недействителен"
    end

    local expires = tonumber(expiresText) or 0
    now = now or os.time()
    if expires ~= 0 and now >= expires then
        return false, "Срок действия ключа истёк"
    end

    if hwidPart ~= "ANY" then
        if not hwid then
            return false, "Ключ привязан к HWID, а исполнитель его не отдаёт"
        end
        local mine = sha256Hex(hwid):sub(1, 8):upper()
        if mine ~= hwidPart then
            return false, "Ключ привязан к другому устройству"
        end
    end

    return true, "Ключ действителен", expires ~= 0 and (expires - now) or nil
end
-- @core-end

